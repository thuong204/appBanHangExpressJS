extends ../../layouts/default.pug
block main
  .dashboard-container
    .row.mb-4
      .col-xl-3.col-md-6.mb-4
        .card.border-left-primary.shadow.h-100.py-2
          .card-body
            .row.no-gutters.align-items-center
              .col.mr-2
                .text-xs.font-weight-bold.text-primary.text-uppercase.mb-1 Doanh thu (tháng này)
                .h5.mb-0.font-weight-bold.text-gray-800 #{revenueMonth}
              .col-auto
                i.fas.fa-calendar.fa-2x.text-gray-300
          .card-footer.small.text-muted
            | Cập nhật lúc #{updatedAt}

      .col-xl-3.col-md-6.mb-4
        .card.border-left-success.shadow.h-100.py-2
          .card-body
            .row.no-gutters.align-items-center
              .col.mr-2
                .text-xs.font-weight-bold.text-success.text-uppercase.mb-1 Doanh thu (năm #{currentCalendarYear})
                .h5.mb-0.font-weight-bold.text-gray-800 #{revenueYear}
              .col-auto
                i.fas.fa-dollar-sign.fa-2x.text-gray-300
          .card-footer.small.text-muted
            | Cập nhật lúc #{updatedAt}

      .col-xl-3.col-md-6.mb-4
        .card.border-left-info.shadow.h-100.py-2
          .card-body
            .row.no-gutters.align-items-center
              .col.mr-2
                .text-xs.font-weight-bold.text-info.text-uppercase.mb-1 Đơn hàng (tháng này)
                .h5.mb-0.font-weight-bold.text-gray-800 #{newOrdersCount}
              .col-auto
                i.fas.fa-shopping-bag.fa-2x.text-gray-300
          .card-footer.small.text-muted
            | Số đơn có ngày đặt trong tháng hiện tại

      .col-xl-3.col-md-6.mb-4
        .card.border-left-warning.shadow.h-100.py-2
          .card-body
            .row.no-gutters.align-items-center
              .col.mr-2
                .text-xs.font-weight-bold.text-warning.text-uppercase.mb-1 Khách mới (tháng này)
                .h5.mb-0.font-weight-bold.text-gray-800 #{newUsersCount}
              .col-auto
                i.fas.fa-users.fa-2x.text-gray-300
          .card-footer.small.text-muted
            | Tài khoản khách (users) đăng ký trong tháng

    .row.mb-4
      .col-xl-8.col-lg-7
        .card.shadow.mb-4
          .card-header.py-3.d-flex.flex-row.align-items-center.justify-content-between.flex-wrap.gap-2
            h6.m-0.font-weight-bold.text-primary Doanh thu theo tháng
            .d-flex.align-items-center.gap-2
              label.small.text-muted.mb-0(for="dashboard-chart-year") Năm
              select#dashboard-chart-year.form-select.form-select-sm(style="max-width: 120px" onchange=`window.location.href='${prefixAdmin}/dashboard?year=' + encodeURIComponent(this.value)`)
                each y in availableChartYears
                  option(value=y selected=(y == chartYear)) #{y}
          .card-body
            .chart-container(style='position: relative; height:300px;')
              canvas#revenueChart
            .small.text-muted.mt-2
              | Tổng doanh thu năm #{chartYear}: 
              strong #{revenueSelectedYear}

      .col-xl-4.col-lg-5
        .card.shadow.mb-4
          .card-header.py-3.d-flex.flex-row.align-items-center.justify-content-between
            h6.m-0.font-weight-bold.text-primary Sản phẩm theo danh mục
          .card-body
            .chart-container(style='position: relative; height:300px;')
              canvas#categoryChart
            .small.text-muted.mt-2
              | Tổng 
              strong #{categoryProductTotal}
              |  sản phẩm đang bán — theo danh mục trong 
              code category-products

    .row
      .col-lg-6.mb-4
        .card.shadow.mb-4
          .card-header.py-3.d-flex.justify-content-between.align-items-center
            h6.m-0.font-weight-bold.text-primary Đơn hàng gần đây
            a.small(href=`${prefixAdmin}/orders`) Xem tất cả
          .card-body
            .table-responsive
              table.table.table-bordered.table-hover
                thead
                  tr
                    th Mã đơn
                    th Khách hàng
                    th Trạng thái
                    th Giá trị
                    th Thời gian
                tbody
                  if recentOrders && recentOrders.length
                    each row in recentOrders
                      tr
                        td
                          a(href=`${prefixAdmin}/orders/detail/${row.id}`) ##{row.code}
                        td #{row.customer}
                        td
                          span(class=`badge bg-${row.statusClass}`) #{row.statusLabel}
                        td #{row.total}
                        td #{row.time}
                  else
                    tr
                      td.text-muted.text-center.py-4(colspan=5) Chưa có đơn hàng

      .col-lg-6.mb-4
        .card.shadow.mb-4
          .card-header.py-3
            h6.m-0.font-weight-bold.text-primary Sản phẩm bán chạy (theo đơn hàng)
          .card-body
            .table-responsive
              table.table.table-bordered.table-hover
                thead
                  tr
                    th Sản phẩm
                    th Danh mục
                    th Đã bán
                    th Doanh thu
                    th Tồn kho
                tbody
                  if topProducts && topProducts.length
                    each row in topProducts
                      tr
                        td #{row.title}
                        td #{row.category}
                        td #{row.soldQty}
                        td #{row.revenue}
                        td #{row.stock}
                  else
                    tr
                      td.text-muted.text-center.py-4(colspan=5) Chưa có dữ liệu bán hàng

  script(src='https://cdn.jsdelivr.net/npm/chart.js')
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const monthLabels = !{JSON.stringify(monthLabels)};
      const revenueByMonthMillions = !{JSON.stringify(revenueByMonthMillions)};
      const categoryLabels = !{JSON.stringify(categoryChartLabels)};
      const categoryData = !{JSON.stringify(categoryChartData)};
      const chartYear = !{JSON.stringify(chartYear)};

      const palette = [
        'rgba(78, 115, 223, 0.85)',
        'rgba(28, 200, 138, 0.85)',
        'rgba(246, 194, 62, 0.85)',
        'rgba(54, 185, 204, 0.85)',
        'rgba(231, 74, 59, 0.85)',
        'rgba(155, 89, 182, 0.85)',
        'rgba(52, 152, 219, 0.85)',
        'rgba(149, 165, 166, 0.85)'
      ];
      const categoryColors = categoryLabels.map((_, i) => palette[i % palette.length]);

      const revenueCtx = document.getElementById('revenueChart');
      if (revenueCtx) {
        new Chart(revenueCtx, {
          type: 'line',
          data: {
            labels: monthLabels,
            datasets: [{
              label: 'Doanh thu (triệu đồng) — năm ' + chartYear,
              data: revenueByMonthMillions,
              borderColor: 'rgba(78, 115, 223, 1)',
              backgroundColor: 'rgba(78, 115, 223, 0.1)',
              borderWidth: 2,
              pointBackgroundColor: 'rgba(78, 115, 223, 1)',
              pointBorderColor: '#fff',
              pointBorderWidth: 2,
              pointRadius: 4,
              pointHoverRadius: 6,
              fill: true,
              tension: 0.3
            }]
          },
          options: {
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                grid: { color: 'rgba(0, 0, 0, 0.05)' }
              },
              x: {
                grid: { display: false }
              }
            }
          }
        });
      }

      const categoryCtx = document.getElementById('categoryChart');
      if (categoryCtx) {
        new Chart(categoryCtx, {
          type: 'doughnut',
          data: {
            labels: categoryLabels,
            datasets: [{
              label: 'Số sản phẩm',
              data: categoryData,
              backgroundColor: categoryColors,
              borderWidth: 0,
              hoverOffset: 5
            }]
          },
          options: {
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 15,
                  usePointStyle: true
                }
              }
            }
          }
        });
      }
    });
