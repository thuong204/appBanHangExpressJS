extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/formatDateTime.pug
include ../../mixins/pagination.pug
block main 
       
        +alert-success(3000)
        +alert-error(3000)
        
        .d-flex.justify-content-between.align-items-center.mb-4
            h1.m-0 
                i.fas.fa-shopping-cart.me-2.text-primary
                | Quản lý đơn hàng

        .card.shadow-sm.mb-4
            .card-header.bg-white.py-3
                h5.card-title.m-0
                    i.fas.fa-list.me-2.text-primary
                    | Danh sách đơn hàng
            .card-body.p-0
                .table-responsive
                    table.table.table-hover.align-middle.mb-0
                        thead.bg-light
                            tr
                                th.py-3 STT
                                th.py-3 Mã đơn hàng
                                th.py-3 Khách hàng
                                th.py-3 Số điện thoại
                                th.py-3 Địa chỉ
                                th.py-3 Thanh toán
                                th.py-3 Ngày đặt
                                th.py-3 Trạng thái
                                th.py-3.text-end Thao tác
                        tbody
                            if(orders && orders.length > 0)
                                each item, index in orders
                                    tr
                                        td.py-3 #{(pagination ? (pagination.currentPage - 1) * pagination.limitItems : 0) + index + 1}
                                        td.py-3 
                                            span.text-primary.fw-medium #{String(item._id).slice(-6).toUpperCase()}
                                        td.py-3 #{item.userInfo && item.userInfo.fullName ? item.userInfo.fullName : "—"}
                                        td.py-3 #{item.userInfo && item.userInfo.phone ? item.userInfo.phone : "—"}
                                        td.py-3 #{item.userInfo && item.userInfo.address ? item.userInfo.address : "—"}
                                        td.py-3 
                                            if(item.payments === "paymentdelivery" || item.payments === "ship-cod")
                                                span.badge.bg-info.text-white
                                                    i.fas.fa-truck.me-1
                                                    | Thanh toán khi nhận hàng
                                            else if(item.payments === "paymentcard")
                                                span.badge.bg-success.text-white
                                                    i.fas.fa-credit-card.me-1
                                                    | Thanh toán trực tuyến
                                            else
                                                span.badge.bg-secondary.text-white
                                                    i.fas.fa-money-bill.me-1
                                                    | #{item.payments || "Không rõ"}
                                        td.py-3 
                                            small.text-muted
                                                i.far.fa-calendar-alt.me-1.text-secondary
                                                if(item.dateOrder)
                                                    +formatDateTime(item.dateOrder)
                                                else
                                                    +formatDateTime(item.createdAt)
                                        td.py-3
                                            case item.status
                                                when "pending"
                                                when "Chưa thanh toán"
                                                    span.badge.bg-warning.text-white.px-3.py-2
                                                        i.fas.fa-clock.me-1
                                                        | Chờ xác nhận
                                                when "processing"
                                                when "Đang xử lý"
                                                    span.badge.bg-primary.text-white.px-3.py-2
                                                        i.fas.fa-cog.me-1
                                                        | Đang xử lý
                                                when "shipping"
                                                when "Đang giao hàng"
                                                    span.badge.bg-info.text-white.px-3.py-2
                                                        i.fas.fa-truck.me-1
                                                        | Đang giao hàng
                                                when "delivered"
                                                when "Đã giao hàng"
                                                    span.badge.bg-success.text-white.px-3.py-2
                                                        i.fas.fa-check-circle.me-1
                                                        | Đã giao hàng
                                                when "canceled"
                                                when "Đã hủy"
                                                    span.badge.bg-danger.text-white.px-3.py-2
                                                        i.fas.fa-times-circle.me-1
                                                        | Đã hủy
                                                when "Paid"
                                                when "Đã thanh toán"
                                                    span.badge.bg-success.text-white.px-3.py-2
                                                        i.fas.fa-check-circle.me-1
                                                        | Đã thanh toán
                                                default
                                                    span.badge.bg-secondary.text-white.px-3.py-2
                                                        i.fas.fa-question-circle.me-1
                                                        | #{item.status || "Không xác định"}
                                        td.py-3.text-end
                                            .btn-group
                                                a(
                                                    href=`${prefixAdmin}/orders/detail/${item.id}`
                                                    class="btn btn-outline-info btn-sm"
                                                    title="Xem chi tiết"
                                                )
                                                    i.fas.fa-eye.text-info
                                                
                                                button.btn.btn-outline-danger.btn-sm.ms-1(
                                                    button-delete
                                                    data-id=item.id
                                                    title="Xóa"
                                                )
                                                    i.fas.fa-trash-alt.text-danger
                            else 
                                tr 
                                    td(colspan=9 class="text-center py-4")
                                        .text-muted
                                            i.fas.fa-info-circle.me-2.text-info
                                            | Chưa có đơn hàng nào

        if(pagination && pagination.totalPage > 1)
            +pagination(pagination)

        form(
            action=""
            method="POST"
            id="form-delete-item"
            data-path=`${prefixAdmin}/orders/delete`
        )