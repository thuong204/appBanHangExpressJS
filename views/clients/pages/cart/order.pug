extends ../../layouts/default.pug
include ../../mixins/section-page.pug
include ../../mixins/alert.pug

block main     
    +alert-success(3000)
    +section-page(pageTitle)
    .body 
        .container 
            .row 
                .col-7
                    h3(class="text-warning") Thông tin đặt hàng
                    form(
                        action="order"
                        method="POST"
                    )
                        div(class="mb-3")
                            label(for="fullname") Họ tên
                            input.form-control(
                                type="text" 
                                id="fullname" 
                                name="fullname" 
                                required 
                                placeholder="Nhập họ tên" )
                        div(class="mb-3")
                            label(for="phone") Số điện thoại
                            input.form-control(
                                type="text" 
                                id="phone" 
                                name="phone" 
                                required 
                                placeholder="Nhập số điện thoại")
                        div(class="mb-3")
                            label(for="address") Địa chỉ nhận hàng:
                            input.form-control(
                                type="text" 
                                id="address" 
                                name="address" 
                                required
                                placeholder="Nhập địa chỉ nhận hàng")
                        div(class="mb-3")
                            label(for="note") Ghi chú đơn hàng
                            textarea.form-control(
                                rows=3
                                id="note"
                                name="note"
                            )
                        div(class="mb-3 form-check-inline form-check" )
                            input(
                                type="radio" 
                                class="form-check-input" 
                                id="paymentdelivery" 
                                name="payment" 
                                checked
                                value="paymentdelivery")
                            label(
                                for="paymentdelivery" 
                                class="form-check-label") Thanh toán khi nhận hàng       
                        div(class="mb-3 form-check-inline form-check" )
                            input(
                                type="radio" 
                                class="form-check-input" 
                                id="paymentcard" 
                                name="payment" 

                                value="paymentcard")
                            label(
                                for="paymentcard" 
                                class="form-check-label") Thanh toán payOS (QR / chuyển khoản)
                        div(class="mb-3")
                            input(type="hidden" name="payosOrderCode" id="payosOrderCode" value=qr.orderCode)
                            each item in cart.products
                                input(type="hidden" name="dataOrder" value=item.product_id)
                        div(class="mb-3")
                            button(type="submit" class="btn btn-warning mb-3" button-order) Đặt hàng
                .col-5
                    .container
                        table.table.table-hover.fs-4.text-uppercase.table-warning.table-border.custom-table
                            thead
                                tr 
                                    th Đơn hàng của bạn
                        table.table.table-hover.table-sm.fs-5(cellspacing="0") 
                            tbody 
                                tr
                                    td(colspan="2")
                                        table.table.fs-6(cellspacing="0").custom-table
                                            thead 
                                                tr 
                                                    th SẢN PHẨM
                                                    th.text-end Tổng
                                            tbody 
                                            each item in cart.products
                                                tr 
                                                    td.text-warning #{item.productInfo.title} 
                                                        span(class="fw-bold") x#{item.quantity}
                                                        if(item.color)
                                                            span (#{item.color}) 
                                                    td.text-end #{item.totalPrice}đ

                                tr 
                                    th  Tổng tiền: 
                                    td.text-end #{cart.totalInter}đ
                                tr 
                                    th Phí vận chuyển 
                                    td.text-end.fs-6 Miễn phí
                                tr 
                                    th Tổng tiền thanh toán: 
                                    td.text-end.text-warning.text-uppercase.fw-bold.fs-5 #{cart.totalInter}đ
                    script#qr-payment-data(type="application/json")!= JSON.stringify({ qr: qr, payosPaid: payosPaid || false })
                    div.modal.fade.container-qr(id='qrModal' tabindex='-1' aria-labelledby='qrModalLabel' aria-hidden='true')
                        div.modal-dialog
                            div.modal-content
                                div.modal-header
                                    h5#qrModalLabel.modal-title Thanh toán qua payOS
                                    button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')
                                div.modal-body
                                    p.text-muted Quét mã QR bằng app ngân hàng hoặc mở trang thanh toán payOS.
                                    div.text-center
                                        img#qrImage(src=`${qr.image}` alt='QR payOS' width='70%')
                                    if qr.checkoutUrl
                                        p.mt-3.text-center
                                            a.btn.btn-primary(href=qr.checkoutUrl target="_blank" rel="noopener") Mở trang thanh toán payOS
                                    .information.fw-bold.mt-3
                                        if qr.information.accountNo
                                            div Số tài khoản: #{qr.information.accountNo}
                                        div Nội dung: #{qr.information.addInfo}
                                        div Số tiền: #{qr.information.amount}đ
                                div.modal-footer.text-center
                                    .wait-payment
                                        span.text-warning Đang chờ xác nhận từ payOS...
                                    button.btn.btn-secondary(type='button' data-bs-dismiss='modal') Đóng
                    div.modal.fade#paymentSuccessModal(tabindex="-1", aria-labelledby="paymentSuccessLabel", aria-hidden="true")
                        div.modal-dialog
                            div.modal-content
                                div.modal-body.text-center
                                    i.fa.fa-check-circle.text-success(style=" font-size: 3rem")
                                    p.payment-success.text-success Thanh toán thành công
                                    p Đơn hàng của quý khách đã thanh toán thành công. Chúng tôi sẽ giao hàng cho bạn trong thời gian sớm nhất.
                                div.modal-footer.d-block.text-center
                                    button.btn.btn-primary(type="button", data-bs-dismiss="modal") OK






