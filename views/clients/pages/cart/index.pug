extends ../../layouts/default.pug
include ../../mixins/section-page.pug
include ../../mixins/alert.pug
block main

    +alert-success(3000)
    +alert-error(3000)
    +section-page("Giỏ hàng")
    .container.page-shell
        h1.page-heading.mb-3
            | Giỏ hàng
            if cart && cart.products.length
                span.page-heading-count #{cart.products.length} sản phẩm

        if !cart || !cart.products.length
            .empty-state
                i.fas.fa-shopping-bag
                h5 Giỏ hàng đang trống
                p Hãy chọn vài sản phẩm bạn yêu thích nhé.
                a.btn.btn-warning(href="/products") Mua sắm ngay
        else
            form(action="/cart/cartOrder" method="post")
                .row.g-4
                    .col-lg-8
                        .surface-card.p-0
                            .cart-list-head
                                span Chọn sản phẩm muốn đặt
                            each item in cart.products
                                .cart-item(data-cart)
                                    label.cart-check
                                        input.form-check-input(type="checkbox" checkedOrder priceItem=item.totalPrice value=item.product_id disabled=item.available <= 0)
                                    a.cart-thumb(href=`/products/detail/${item.productInfo.slug}`)
                                        img(src=item.productInfo.thumbnail alt=item.productInfo.title)
                                    .cart-body
                                        a.cart-title.product-info(href=`/products/detail/${item.productInfo.slug}` product_id=item.product_id) #{item.productInfo.title}
                                        .cart-meta
                                            if item.color
                                                span.cart-color(value=item.color item-color) #{item.color}
                                            else
                                                span.d-none(value="" item-color)
                                            span.cart-unit-price(price-new value=item.productInfo.priceNew) #{item.productInfo.priceInter}đ
                                        if item.available <= 0
                                            .cart-stock-warning
                                                i.fas.fa-exclamation-circle.me-1
                                                | Sản phẩm đã hết hàng, vui lòng xoá khỏi giỏ
                                        else if item.quantity > item.available
                                            .cart-stock-warning
                                                i.fas.fa-exclamation-circle.me-1
                                                | Chỉ còn #{item.available} sản phẩm, vui lòng giảm số lượng
                                        else if item.available <= 5
                                            .cart-stock-low Chỉ còn #{item.available} sản phẩm
                                        .cart-actions
                                            .qty-control.button-add-quantity
                                                input(type="button" value="−" button-decrease aria-label="Giảm")
                                                input(type="text" value=item.quantity value-quantity inputmode="numeric" aria-label="Số lượng")
                                                input(type="button" value="+" button-increase aria-label="Tăng")
                                            a.cart-remove(href=`/cart/delete/${item.product_id}` title="Xoá khỏi giỏ")
                                                i.fas.fa-trash-alt
                                                span.d-none.d-sm-inline.ms-1 Xoá
                                    .cart-line-total(total-price) #{item.totalPriceInter}đ

                    .col-lg-4
                        .surface-card.summary-card
                            h5.summary-title Tóm tắt đơn hàng
                            .summary-row
                                span Tạm tính
                                span.fw-semibold(total-cart=cart.total) 0đ
                            .summary-row
                                span Phí vận chuyển
                                span.text-success.fw-semibold Miễn phí
                            .summary-row.summary-total
                                span Tổng thanh toán
                                span(sub-total=cart.total) 0đ
                            p.summary-hint Tích chọn sản phẩm bên trái để tính tổng.
                            button.btn.btn-warning.btn-lg.w-100(type="submit") Tiến hành đặt hàng
                            a.summary-back(href="/products")
                                i.fas.fa-arrow-left.me-2
                                | Tiếp tục mua sắm
