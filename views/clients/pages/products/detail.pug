extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/grid-products-category.pug
include ../../mixins/section-page.pug

block main
    +alert-success(3000)
    +alert-error(3000)
    
    // Breadcrumb
    .container.mt-3
       +section-page(pageTitle, breadcrumbs)
        

    // Product Detail Section
    section.product-detail.py-4(data-kind=product.kind)
        .container
            .row.g-3.g-md-4
                // Product Gallery
                .col-lg-7.col-md-6
                    .product-gallery
                        .main-image-wrapper
                            .main-image
                                img#main-thumbnail.img-fluid.rounded-3(src=product.thumbnail alt=product.title)
                            if product.listImage.length
                                .image-controls
                                    button.btn-control.prev(type="button")
                                        i.fas.fa-chevron-left
                                    button.btn-control.next(type="button")
                                        i.fas.fa-chevron-right
                        
                        if product.listImage.length
                            .thumbnail-list
                                .thumbnail-item.active
                                    img.thumbnail-img(src=product.thumbnail alt="Thumbnail")
                                each image in product.listImage
                                    .thumbnail-item
                                        img.thumbnail-img(src=image alt="Thumbnail" loading="lazy")

                // Product Info
                .col-lg-5.col-md-6
                    .product-info
                        // Title and Price
                        .product-header.mb-4
                            .product-meta.mb-2
                                span.product-kind-badge
                                    i.fas.me-1(class=product.kindIcon)
                                    | #{product.categoryTitle || product.kindLabel}
                                if product.stock > 0
                                    span.stock-badge.in-stock
                                        i.fas.fa-check-circle.me-1
                                        | Còn hàng
                                else
                                    span.stock-badge.out-stock Hết hàng
                            h1.product-title #{product.title}
                            .product-price.mt-3
                                if product.discountPercentage && product.priceNew
                                    .price-new #{product.priceNew}đ
                                    .price-old #{product.priceInter}đ
                                    span.price-discount -#{product.discountPercentage}%
                                else
                                    .price-new #{product.priceInter}đ
                        
                        // Thông số nhanh: chỉ với sản phẩm có màn hình (điện thoại, tablet, laptop)
                        if product.screen || product.screenType
                            .product-specs.mb-4
                                .specs-group
                                    h5.specs-title Thông số nổi bật
                                    ul.specs-list
                                        if product.screen
                                            li
                                                i.fas.me-2(class=product.kindIcon)
                                                | Màn hình #{product.screen}
                                        if product.screenType
                                            li
                                                i.fas.fa-desktop.me-2
                                                | #{product.screenType}
                        
                        // Storage Options
                        if productList.length
                            .storage-options.mb-4
                                h5.storage-title #{product.storageLabel}
                                .storage-buttons
                                    each item in productList
                                        a.storage-btn(
                                            href=`/products/detail/${item.slug}`
                                            class=(item.storage === product.storage ? 'active' : '')
                                        ) #{item.storage}
                        
                        // Color Options
                        if product.showVariations
                            .color-options.mb-4
                                h5.color-title #{product.colorLabel}
                                .color-buttons
                                    each item in product.variations
                                        button.color-btn(
                                            type="button"
                                            data-color=item.color
                                            title=item.color
                                            data-stock=item.quantity
                                            class=item.color === product.color ? 'active' : ''
                                            disabled=item.quantity === 0
                                        )
                                            if item.swatch
                                                span.color-swatch(style=`background-color: ${item.swatch}`)
                                            span.color-name #{item.color}
                                            if item.quantity === 0
                                                small.color-soldout Hết
                        
                        // Chính sách theo loại sản phẩm
                        if product.perks && product.perks.length
                            ul.product-perks.mb-4
                                each perk in product.perks
                                    li
                                        i.fas.fa-shield-alt.me-2
                                        | #{perk}
                        
                        // Add to Cart Form
                        if product.stock > 0
                            form.add-to-cart-form(action=`/cart/add/${product.id}` method="POST")
                                .quantity-selector.mb-4
                                    label.form-label(for="quantity") Số lượng
                                    .d-flex.align-items-center.gap-3.flex-wrap
                                        .quantity-input-group
                                            button.quantity-btn.decrease(type="button") -
                                            input#quantity.form-control(
                                                type="number"
                                                name="quantity"
                                                value="1"
                                                min="1"
                                                max=product.stockSelected
                                            )
                                            button.quantity-btn.increase(type="button") +
                                        span.stock-left(data-stock-left)
                                            if product.stockSelected <= 5
                                                | Chỉ còn #{product.stockSelected} sản phẩm
                                            else
                                                | Còn #{product.stockSelected} sản phẩm
                                
                                input(type="hidden" name="color" id="color-input" value=product.color || "")
                                
                                .action-buttons
                                    button.btn.btn-warning.btn-lg.btn-add-cart(type="submit")
                                        i.fas.fa-shopping-cart.me-2
                                        | Thêm vào giỏ
                                    //- Mua ngay: thêm vào giỏ rồi chuyển thẳng tới giỏ hàng
                                    button.btn.btn-danger.btn-lg.btn-buy-now(type="submit" name="buyNow" value="1")
                                        i.fas.fa-bolt.me-2
                                        | Mua ngay
                        else
                            .soldout-box
                                i.fas.fa-box-open
                                div
                                    strong Sản phẩm tạm hết hàng
                                    span Liên hệ hotline 1900 1234 hoặc
                                        a.ms-1(href="/contact") để lại lời nhắn
                                        |  để được báo khi có hàng.

    // Product Description
    section.product-description.py-4
        .container
            .row
                .col-12
                    .description-tabs
                        ul.nav.nav-tabs#productTabs(role="tablist")
                            li.nav-item
                                a.nav-link.active#description-tab(
                                    data-bs-toggle="tab"
                                    href="#description"
                                    role="tab"
                                ) Mô tả sản phẩm
                            li.nav-item
                                a.nav-link#features-tab(
                                    data-bs-toggle="tab"
                                    href="#features"
                                    role="tab"
                                ) Đặc điểm nổi bật
                            li.nav-item
                                a.nav-link#specs-tab(
                                    data-bs-toggle="tab"
                                    href="#specs"
                                    role="tab"
                                ) Thông số kỹ thuật
                        
                        .tab-content#productTabsContent
                            .tab-pane.fade.show.active#description(role="tabpanel")
                                .content-wrapper !{product.content}
                            
                            .tab-pane.fade#features(role="tabpanel")
                                .content-wrapper !{product.description}
                            
                            .tab-pane.fade#specs(role="tabpanel")
                                .content-wrapper !{product.specsHtml}

    // Related Products
    section.related-products.py-4
        .container
            h2.section-title.mb-4
                i.fas.fa-sync-alt.me-2
                | Sản phẩm tương tự
            .row.g-3.g-md-4
                +grid-products(productstRelated)

