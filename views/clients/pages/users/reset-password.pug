extends ../../layouts/default-2.pug
include ../../mixins/alert.pug
block main 
    +alert-success(3000)
    +alert-error(3000)
    .auth-page
        form.auth-card(action="/user/password/reset" method="post")
            .auth-head
                span.auth-icon
                    i.fas.fa-lock
                h1 Đặt mật khẩu mới
                p Chọn mật khẩu mạnh để bảo vệ tài khoản.
            .mb-3
                label.form-label(for="password") Mật khẩu mới
                input.form-control(type="password" id="password" name="password" autocomplete="new-password" required)
            .mb-4
                label.form-label(for="confirmpassword") Xác nhận mật khẩu
                input.form-control(type="password" id="confirmpassword" name="confirmpassword" autocomplete="new-password" required)
            button.btn.btn-warning.btn-lg.w-100(type="submit") Đổi mật khẩu
