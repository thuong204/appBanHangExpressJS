extends ../../layouts/default-2.pug
include ../../mixins/alert.pug
block main 
    +alert-success(3000)
    +alert-error(3000)

    .auth-page
        form.auth-card(action="register" method="POST")
            .auth-head
                span.auth-icon
                    i.fas.fa-user-plus
                h1 Tạo tài khoản
                p Mua sắm nhanh hơn và theo dõi đơn hàng dễ dàng.

            .mb-3
                label.form-label(for="fullName") Họ và tên
                input.form-control(type="text" id="fullName" name="fullName" autocomplete="name" placeholder="Nguyễn Văn A")
            .row.g-3.mb-3
                .col-sm-6
                    label.form-label(for="dateOfBirth") Ngày sinh
                    input.form-control(type="date" id="dateOfBirth" name="dateOfBirth")
                .col-sm-6
                    label.form-label(for="phone") Số điện thoại
                    input.form-control(type="tel" id="phone" name="phone" autocomplete="tel" placeholder="09xx xxx xxx")
            .mb-3
                label.form-label(for="email") Email
                input.form-control(type="email" id="email" name="email" autocomplete="email" placeholder="ban@email.com")
            .mb-4
                label.form-label(for="password") Mật khẩu
                input.form-control(type="password" id="password" name="password" autocomplete="new-password" placeholder="••••••••")
                .form-text Ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.

            button.btn.btn-warning.btn-lg.w-100(type="submit") Đăng ký

            .auth-divider
                span hoặc

            .d-grid.gap-2
                a.btn-social(href="/user/login/federated/google")
                    img(src="https://res.cloudinary.com/dwk6tmsmh/image/upload/v1722602737/jnwhzzq4939gb1gl7edy.png" alt="")
                    | Tiếp tục với Google
                a.btn-social(href="/user/login/federated/facebook")
                    img(src="https://res.cloudinary.com/dwk6tmsmh/image/upload/v1729341273/zrzv5lyvnzpyfslzncoj.png" alt="")
                    | Tiếp tục với Facebook

            p.auth-foot
                | Đã có tài khoản?
                a(href="login") Đăng nhập
