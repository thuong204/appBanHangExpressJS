extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/section-page.pug
block main
    +alert-success(3000)
    +alert-error(3000)
    +section-page("Tài khoản")
    .container.page-shell
        .row.g-4
            .col-lg-4
                .surface-card.profile-card
                    if user.avatar
                        img.profile-avatar(src=user.avatar alt="")
                    else
                        span.profile-avatar.profile-avatar-text #{(user.fullName || user.email || "?").trim().charAt(0).toUpperCase()}
                    h1.profile-name #{user.fullName || "Khách hàng"}
                    if user.email
                        p.text-muted.mb-3 #{user.email}
                    if user.status == 'active'
                        span.status-pill.status-paid
                            i.fas.fa-check-circle.me-1
                            | Đang hoạt động
                    else
                        span.status-pill.status-pending Tạm khoá
                    .profile-links
                        a(href="/cart/order/history")
                            i.fas.fa-receipt
                            | Đơn hàng của tôi
                        a(href="/cart")
                            i.fas.fa-shopping-bag
                            | Giỏ hàng
                        a(href="/user/password/forgot")
                            i.fas.fa-key
                            | Đổi mật khẩu
                        a.text-danger(href="/user/logout")
                            i.fas.fa-sign-out-alt
                            | Đăng xuất

            .col-lg-8
                .surface-card
                    h5.card-section-title
                        i.fas.fa-id-card.me-2
                        | Thông tin cá nhân
                    dl.info-list.info-list-wide
                        dt Họ tên
                        dd #{user.fullName || "—"}
                        dt Email
                        dd #{user.email || "—"}
                        dt Số điện thoại
                        dd #{user.phone || "—"}
                        dt Ngày sinh
                        dd #{user.dateOfBirth ? new Date(user.dateOfBirth).toLocaleDateString("vi-VN") : "—"}
                        dt Ngày tham gia
                        dd #{user.createdAt ? new Date(user.createdAt).toLocaleDateString("vi-VN") : "—"}
