extends ../../layouts/default-2.pug
include ../../mixins/alert.pug
block main 
    +alert-success(3000)
    +alert-error(3000)
    .auth-page
        form.auth-card(action="/user/password/otp" method="post")
            .auth-head
                span.auth-icon
                    i.fas.fa-shield-alt
                h1 Nhập mã OTP
                p Mã xác thực đã được gửi tới email của bạn.
            .mb-3
                label.form-label(for="email") Email
                input.form-control(type="text" id="email" name="email" value=email required readonly)
            .mb-4
                label.form-label(for="otp") Mã OTP
                input.form-control.otp-input(type="text" id="otp" name="otp" autocomplete="one-time-code" inputmode="numeric" placeholder="••••••" required)
            button.btn.btn-warning.btn-lg.w-100(type="submit") Xác nhận
            p.auth-foot
                | Chưa nhận được mã?
                a(href="/user/password/forgot") Gửi lại
