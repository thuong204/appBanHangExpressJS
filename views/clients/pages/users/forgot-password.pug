extends ../../layouts/default-2.pug
include ../../mixins/alert.pug
block main 
    +alert-success(3000)
    +alert-error(3000)
    .auth-page
        form.auth-card(action="/user/password/forgot" method="post")
            .auth-head
                span.auth-icon
                    i.fas.fa-key
                h1 Quên mật khẩu
                p Nhập email đã đăng ký, chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.
            .mb-4
                label.form-label(for="email") Email
                input.form-control(type="email" id="email" name="email" autocomplete="email" placeholder="ban@email.com" required)
            button.btn.btn-warning.btn-lg.w-100(type="submit") Gửi mã xác nhận
            p.auth-foot
                a(href="/user/login")
                    i.fas.fa-arrow-left.me-2
                    | Quay lại đăng nhập
