extends ../../layouts/default-2.pug
include ../../mixins/alert.pug
block main 
    +alert-success(3000)
    +alert-error(3000)

    .auth-page
        form.auth-card(action="login" method="post")
            .auth-head
                span.auth-icon
                    i.fas.fa-user
                h1 Đăng nhập
                p Chào mừng bạn quay lại!

            .mb-3
                label.form-label(for="email") Email
                input.form-control(type="email" id="email" name="email" autocomplete="email" placeholder="ban@email.com" required)
            .mb-2
                label.form-label(for="password") Mật khẩu
                input.form-control(type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required)
            .auth-row
                label.form-check
                    input.form-check-input(type="checkbox" name="check")
                    span.form-check-label Ghi nhớ đăng nhập
                a(href="password/forgot") Quên mật khẩu?

            button.btn.btn-warning.btn-lg.w-100(type="submit") Đăng nhập

            .auth-divider
                span hoặc

            .d-grid.gap-2
                a.btn-social(href="/user/login/federated/google")
                    img(src="https://res.cloudinary.com/dwk6tmsmh/image/upload/v1722602737/jnwhzzq4939gb1gl7edy.png" alt="")
                    | Tiếp tục với Google
                a.btn-social(href="/user/login/federated/facebook")
                    img(src="https://res.cloudinary.com/dwk6tmsmh/image/upload/v1729341273/zrzv5lyvnzpyfslzncoj.png" alt="")
                    | Tiếp tục với Facebook

            p.auth-foot
                | Chưa có tài khoản?
                a(href="register") Đăng ký ngay
