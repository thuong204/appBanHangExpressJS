extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/grid-products.pug

mixin section-head(icon, title, href)
    .section-head
        h2.section-head-title
            span.section-head-icon
                i.fas(class=icon)
            | #{title}
        if href
            a.section-head-link(href=href)
                | Xem tất cả
                i.fas.fa-arrow-right.ms-2

block main
    +alert-success(4000)
    +alert-error(4000)
    .container.home
        // Hero: banner + 2 ô khuyến mãi
        section.home-hero
            #homeCarousel.carousel.slide.hero-main(data-bs-ride="carousel")
                .carousel-indicators
                    button.active(type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" aria-current="true" aria-label="Banner 1")
                    button(type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1" aria-label="Banner 2")
                .carousel-inner
                    .carousel-item.active
                        a(href="/search?keyword=iphone")
                            img.d-block.w-100.hero-img-iphone18(src="/images/maxresdefault.jpg" alt="iPhone 18 Pro")
                    .carousel-item
                        img.d-block.w-100(src='https://res.cloudinary.com/dwk6tmsmh/image/upload/v1726925866/dclwzzorvxdehvhgorzw.webp' alt='Khuyến mãi')
                button.carousel-control-prev(type='button' data-bs-target='#homeCarousel' data-bs-slide='prev')
                    span.carousel-control-prev-icon(aria-hidden='true')
                    span.visually-hidden Trước
                button.carousel-control-next(type='button' data-bs-target='#homeCarousel' data-bs-slide='next')
                    span.carousel-control-next-icon(aria-hidden='true')
                    span.visually-hidden Sau

            .hero-side
                a.promo-card.promo-light(href="/products/laptop")
                    .promo-text
                        span.promo-eyebrow Laptop & MacBook
                        strong.promo-title Mạnh mẽ cho mọi công việc
                        span.promo-link Mua ngay
                            i.fas.fa-arrow-right.ms-2
                    img(src="/images/64346432323.png" alt="MacBook Pro M5 Pro" loading="lazy")
                a.promo-card.promo-warm(href="/products/phu-kien")
                    .promo-text
                        span.promo-eyebrow Phụ kiện chính hãng
                        strong.promo-title Âm thanh đỉnh cao
                        span.promo-link Khám phá
                            i.fas.fa-arrow-right.ms-2
                    img(src="https://cdn.dummyjson.com/product-images/mobile-accessories/apple-airpods/thumbnail.webp" alt="" loading="lazy")

        // Cam kết dịch vụ
        section.trust-strip
            .trust-item
                i.fas.fa-shipping-fast
                div
                    strong Giao nhanh 2 giờ
                    span Miễn phí đơn từ 500K
            .trust-item
                i.fas.fa-shield-alt
                div
                    strong Hàng chính hãng
                    span Bảo hành đến 24 tháng
            .trust-item
                i.fas.fa-sync-alt
                div
                    strong Đổi trả 30 ngày
                    span 1 đổi 1 nếu lỗi
            .trust-item
                i.fas.fa-credit-card
                div
                    strong Trả góp 0%
                    span Duyệt nhanh qua thẻ

        // Danh mục
        if categoryTiles && categoryTiles.length
            section.home-section
                +section-head("fa-th-large", "Danh mục nổi bật", "/products")
                .category-tiles
                    each tile in categoryTiles
                        a.category-tile(href=`/products/${tile.slug}`)
                            span.category-tile-icon
                                i.fas(class=tile.icon)
                            span.category-tile-name #{tile.title}
                            span.category-tile-count #{tile.count} sản phẩm

        // Giảm giá
        section.home-section.home-section-deal
            +section-head("fa-bolt", "Giảm giá sốc", "/products?sort=discount")
            .row.g-3.g-md-4
                +grid-products(productDiscount)

        // Nổi bật
        section.home-section
            +section-head("fa-star", "Sản phẩm nổi bật", "/products")
            .row.g-3.g-md-4
                +grid-products(productsFeatured)

        // Mới
        section.home-section
            +section-head("fa-certificate", "Hàng mới về", "/products?sort=new")
            .row.g-3.g-md-4
                +grid-products(productsNew)
