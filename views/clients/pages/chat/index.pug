extends ../../layouts/default.pug
include ../../mixins/grid-products.pug
include ../../mixins/section-page.pug
block main 
    +section-page("Hỗ trợ khách hàng")
    .container.page-shell
            .chat-shell(myId= user.id)
                    .card.chat-card
                        .chat-card-head
                            span.chat-avatar
                                i.fas.fa-headset
                            div
                                strong Hỗ trợ khách hàng
                                small
                                    span.online-dot
                                    | Thường phản hồi trong vài phút
                        .card-body.chat-body
                            .chat-messages.mb-3
                                each chat in chats
                                    if(chat.sender == user.id)
                                        .sender 
                                            if(chat.content)
                                                .message-bubble #{chat.content} 
                                            if(chat.images.length >0 )
                                                .inner-images 
                                                    each image in chat.images   
                                                        img(src=image width= "100px")
                                    if(chat.sender == store.id)
                                        .receiver
                                            if(chat.content)
                                                .message-bubble #{chat.content} 
                                            if(chat.images)
                                                .inner-images 
                                                    each image in chat.images   
                                                        img(src=image width= "100px")
                                div(class="inner-list-typing")
                            .inner-preview-images
                                div(class="custom-file-container" data-upload-id="my-unique-id")

                        .card-footer
                            form(id ="form-send")
                                .input-group
                                    input.form-control(type="text" placeholder="Nhập tin nhắn..." name= "content" input-chat autocomplete="off")
                                    label(for ="file-upload-with-preview-my-unique-id" class="btn-image mt-1") <i class="fas fa-image"></i>
                                    i(class="far fa-smile btn-icon" width="20px")
                                    button.btn-send(type="submit" btn-send)  <i class="fas fa-paper-plane text-light"></i>
            div(class="tooltip" role="tooltip")
                emoji-picker
    script(src="/socket.io/socket.io.js") 
    script(type="module" src="/js/chat.js") 