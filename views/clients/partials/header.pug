include ../mixins/sub-menu.pug

// Thanh thông báo trên cùng
.topbar.d-none.d-md-block
    .container.d-flex.justify-content-between.align-items-center
        span
            i.fas.fa-truck.me-2
            | Miễn phí giao hàng cho đơn từ 500.000đ
        .topbar-links
            a(href="/news")
                i.fas.fa-newspaper.me-1
                | Tin tức
            a(href="/contact")
                i.fas.fa-headset.me-1
                | Liên hệ
            a(href="tel:19001234")
                i.fas.fa-phone-alt.me-1
                | 1900 1234

header.site-header
    .container
        .site-header-main
            // Mobile menu
            button.header-icon-btn.d-lg-none(type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNavOffcanvas" aria-label="Mở danh mục")
                i.fas.fa-bars

            a.site-logo(href="/")
                img(src="/images/dina.png" alt="Vô Thường")

            button.btn-categories.d-none.d-lg-inline-flex(type="button" data-bs-toggle="offcanvas" data-bs-target="#mainNavOffcanvas")
                i.fas.fa-th-large.me-2
                | Danh mục

            form.site-search(action="/search" method="GET" role="search")
                i.fas.fa-search.site-search-icon
                input(
                    type="search"
                    placeholder="Bạn cần tìm gì hôm nay?"
                    name="keyword"
                    value=keyword
                    aria-label="Tìm kiếm sản phẩm"
                )
                button(type="submit") Tìm

            .site-actions
                a.header-action(href="/cart" title="Giỏ hàng")
                    span.header-action-icon
                        i.fas.fa-shopping-bag
                        if cartCount
                            span.cart-count #{cartCount > 99 ? '99+' : cartCount}
                    span.header-action-label.d-none.d-xl-inline Giỏ hàng

                .dropdown
                    button.header-action(type="button" data-bs-toggle="dropdown" aria-expanded="false")
                        span.header-action-icon
                            i.fas.fa-user
                        span.header-action-label.d-none.d-xl-inline= user ? user.name : "Tài khoản"
                    ul.dropdown-menu.dropdown-menu-end.account-menu
                        if(user)
                            li
                                a.dropdown-item(href="/user/info")
                                    i.fas.fa-user-circle.me-2
                                    | Thông tin
                            li
                                a.dropdown-item(href="/cart/order/history")
                                    i.fas.fa-receipt.me-2
                                    | Đơn hàng
                            li
                                hr.dropdown-divider
                            li
                                a.dropdown-item(href="/user/logout")
                                    i.fas.fa-sign-out-alt.me-2
                                    | Đăng xuất
                        else
                            li
                                a.dropdown-item(href="/user/login")
                                    i.fas.fa-sign-in-alt.me-2
                                    | Đăng nhập
                            li
                                a.dropdown-item(href="/user/register")
                                    i.fas.fa-user-plus.me-2
                                    | Đăng ký

    // Thanh danh mục (cuộn ngang trên mobile)
    nav.category-bar(aria-label="Danh mục sản phẩm")
        .container
            ul.category-bar-list
                each item in categoryProducts
                    li
                        a(href=`/products/${item.slug}`)
                            i.fas(class=item.icon)
                            span #{item.title}
                li
                    a(href="/products?sort=discount")
                        i.fas.fa-fire.text-danger
                        span Khuyến mãi
                li
                    a(href="/news")
                        i.fas.fa-newspaper
                        span Tin tức

// Mobile sidebar menu
.offcanvas.offcanvas-start#mainNavOffcanvas(tabindex="-1")
    .offcanvas-header
        h5.offcanvas-title
            i.fas.fa-th-large.me-2
            | Danh mục
        button.btn-close(type="button" data-bs-dismiss="offcanvas" aria-label="Đóng")
    .offcanvas-body.p-0
        .list-group.list-group-flush
            a.list-group-item.list-group-item-action(href="/")
                i.fas.fa-home.me-3
                | Trang chủ
            a.list-group-item.list-group-item-action(href="/products")
                i.fas.fa-store.me-3
                | Tất cả sản phẩm
            each item in categoryProducts
                a.list-group-item.list-group-item-action(href=`/products/${item.slug}`)
                    i.fas.me-3(class=item.icon)
                    | #{item.title}
            a.list-group-item.list-group-item-action(href="/news")
                i.fas.fa-newspaper.me-3
                | Tin tức
            a.list-group-item.list-group-item-action(href="/contact")
                i.fas.fa-envelope.me-3
                | Liên hệ
            a.list-group-item.list-group-item-action(href="/stores")
                i.fas.fa-map-marker-alt.me-3
                | Hệ thống cửa hàng

        .p-3.mt-2
            if(user)
                .d-grid.gap-2
                    a.btn.btn-light(href="/user/info")
                        i.fas.fa-user-circle.me-2
                        | Thông tin tài khoản
                    a.btn.btn-light(href="/cart/order/history")
                        i.fas.fa-receipt.me-2
                        | Lịch sử mua hàng
                    a.btn.btn-outline-secondary(href="/user/logout")
                        i.fas.fa-sign-out-alt.me-2
                        | Đăng xuất
            else
                .d-grid.gap-2
                    a.btn.btn-warning.fw-semibold(href="/user/login") Đăng nhập
                    a.btn.btn-outline-secondary(href="/user/register") Đăng ký
